        <TextArea fx:id="consoleTextArea" layoutX="14.0" layoutY="65.0" prefHeight="253.0" prefWidth="581.0" AnchorPane.bottomAnchor="15.0" AnchorPane.leftAnchor="15.0" AnchorPane.rightAnchor="15.0" AnchorPane.topAnchor="65.0" />
      <Separator layoutX="155.0" layoutY="13.0" orientation="VERTICAL" prefHeight="30.0" prefWidth="2.0" />
